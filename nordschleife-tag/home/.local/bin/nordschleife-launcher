#!/usr/bin/env bash
# Nordschleife launcher: a floating foot window running fzf over desktop entries.
# Hyprland gives it the instrument frame (see hypr/nordschleife-tag.lua);
# foot requests the blur through ext-background-effect.
# Pressing the bind again while it is open closes it.
set -euo pipefail

if hyprctl clients -j | grep -q '"class": "nordschleife-launcher"'; then
    hyprctl eval 'nordschleife_close_launcher()' >/dev/null
    exit 0
fi

exec foot \
    --app-id=nordschleife-launcher \
    --title=Launcher \
    -o main.pad=18x14 \
    -o main.font="Overpass Mono:size=10.5" \
    -o main.line-height=22 \
    -o colors-dark.alpha=0.94 \
    -o colors-light.alpha=0.94 \
    "$HOME/.local/bin/nordschleife-launcher-menu"
