# Nordschleife tag theme + add-ons. Paths relative to $HOME; directories are copied whole.

# Hyprland (core Lua config is included because nordschleife-tag.lua/workspaces.lua are
# required from it and it launches the nordschleife-*/hattin-* helpers)
.config/hypr/hyprland.lua
.config/hypr/futuwwa.lua
.config/hypr/nordschleife-tag.lua
.config/hypr/workspaces.lua
.config/hypr/hyprlock.conf
.config/hypr/hypridle.conf
.config/hypr/hyprpaper.conf
.config/hypr/nordschleife-tag

# Waybar
.config/waybar/config.jsonc
.config/waybar/style.css
.config/waybar/nordschleife-tag

# GTK / Thunar, fonts, icons
.config/gtk-3.0/gtk.css
.config/gtk-3.0/settings.ini
.config/gtk-3.0/nordschleife-tag
.config/gtk-4.0/gtk.css
.config/gtk-4.0/settings.ini
.config/fontconfig/fonts.conf
.local/share/fonts/nordschleife-tag
.local/share/icons/NordschleifeTag
.local/share/icons/NordschleifeTagNadel

# Terminals, shell, multiplexer, (unused) fuzzel, notifications
.config/foot/foot.ini
.config/alacritty/alacritty.toml
.config/ghostty/config.ghostty
.config/tmux/tmux.conf
.config/zsh/nordschleife-tag.zsh-theme
.config/fuzzel/fuzzel.ini
.config/swaync/style.css
.config/swaync/nordschleife-tag

# Helpers: launcher, lock, workspaces, bar scripts
.local/bin/nordschleife-launcher
.local/bin/nordschleife-launcher-menu
.local/bin/nordschleife-lock-saying
.local/bin/nordschleife-lock-scale
.local/bin/hattin-workspaces
.local/bin/hattin-bluetooth-ui
.local/bin/hattin-cliphist-store
.local/bin/hattin-idle
.local/bin/hattin-keys
.local/bin/hattin-lock
.local/bin/hattin-monitor-recover
.local/bin/lock-unless-ssh-active
.local/bin/waybar-nvidia
.local/bin/waybar-proton
.local/bin/waybar-tailscale

# Add-on: yawm (Taskwarrior tasks; task *data* is not included)
.config/task/taskrc
.local/bin/waybar-yawm
.local/bin/nordschleife-yawm
.local/bin/nordschleife-yawm-menu

# Add-on: mawaqit prayer times
.config/mawaqit/mosques
.config/containers/systemd/mawaqit-api.container
.local/share/mawaqit-api
.local/share/mawaqit/sounds
.local/bin/waybar-mawaqit
.local/bin/mawaqit-alert

# User services
.config/systemd/user/hattin-workspaces.service
.config/systemd/user/mawaqit-alerts.service
.config/systemd/user/cliphist.service.d/override.conf
