#!/usr/bin/env python3
"""Prayer alert banner (Nordschleife nacht): a flat instrument plate with crop marks, a tick scale and a prayer gauge on every monitor, above
fullscreen windows, without taking keyboard focus. Click to dismiss.

    mawaqit-alert '<json>'
      kind      "adhan" | "iqama"
      en, ar    prayer name ("Asr", "العصر")
      time      "17:00"          mosque  "Paris"
      iqama     "17:10" | null   iqama_ts  epoch of the iqama | null
      duration  seconds on screen
Sound: ~/.local/share/mawaqit/sounds/<kind>.wav; MAWAQIT_CHIME=<file> overrides,
MAWAQIT_CHIME= (empty) silences. Rings again after MAWAQIT_REPEAT seconds (60)
unless dismissed.

Launched by `waybar-mawaqit watch` (mawaqit-alerts.service). Namespace
hattin-mawaqit, so hypr/nordschleife-nacht.lua's ^hattin- layer rule blurs behind it.
Everything is drawn here with cairo; there are no image files.
"""

import json
import math
import os
import subprocess
import sys
import time

LIB = "/usr/lib/libgtk4-layer-shell.so"
if LIB not in os.environ.get("LD_PRELOAD", ""):  # must load before libwayland
    os.environ["LD_PRELOAD"] = f"{LIB} {os.environ.get('LD_PRELOAD', '')}".strip()
    os.execv(sys.executable, [sys.executable] + sys.argv)

import gi  # noqa: E402
gi.require_version("Gtk", "4.0")
gi.require_version("Gdk", "4.0")
gi.require_version("Gtk4LayerShell", "1.0")
gi.require_version("Pango", "1.0")
gi.require_version("PangoCairo", "1.0")
from gi.repository import Gdk, GLib, Gtk, Gtk4LayerShell as LS, Pango, PangoCairo  # noqa: E402
import cairo  # noqa: E402

SOUNDS = os.path.expanduser("~/.local/share/mawaqit/sounds")  # adhan.wav, iqama.wav (make.py)
FALLBACK = "/usr/share/sounds/freedesktop/stereo/complete.oga"
REPEAT = int(os.environ.get("MAWAQIT_REPEAT", "60"))  # seconds until the reminder ring


def chime(kind):
    """MAWAQIT_CHIME overrides (empty = silent); else the bell for this kind."""
    if "MAWAQIT_CHIME" in os.environ:
        return os.environ["MAWAQIT_CHIME"]
    path = os.path.join(SOUNDS, f"{kind}.wav")
    return path if os.path.exists(path) else FALLBACK
M = 16                                   # room around the plate for its shadow
W, H = 500, 150                          # the plate
PRAYER_INDEX = {"fajr": 0, "shuruq": 0, "dhuhr": 1, "jumua": 1, "asr": 2, "maghrib": 3, "isha": 4}
NEEDLE = {"index": 2}                    # set from the alert before drawing


def rgb(h):
    return tuple(int(h[i:i + 2], 16) / 255 for i in (0, 2, 4))


PANEL, LINE, ALU = rgb("16181B"), rgb("2E3238"), rgb("C9CDD2")
ORANGE, TEXT, MUTED = rgb("FF6A1A"), rgb("F4F5F6"), rgb("8A9099")

CSS = b"""
window { background: transparent; }
.card { padding: 26px 26px 10px 140px; }
.name { font-family: "Saira Stencil One", sans-serif; font-size: 38px; color: #F4F5F6; }
.ar   { font-family: "Noto Kufi Arabic", "IBM Plex Sans Arabic", sans-serif; font-weight: 700; font-size: 24px; color: #C9CDD2; }
.tag  { font-family: "Barlow Semi Condensed", sans-serif; font-weight: 600; font-size: 11px; letter-spacing: 2px; color: #F4F5F6;
        border: 1px solid #C9CDD2; border-radius: 0; padding: 2px 8px 2px 10px; }
.tag.iqama { background: #C9CDD2; color: #0A0A0B; }
.sub  { font-family: "Overpass Mono", monospace; font-size: 12px; color: #8A9099; }
.hint { font-family: "Barlow Semi Condensed", sans-serif; font-weight: 600; font-size: 11px; letter-spacing: 2px; color: #8A9099; }
"""


def draw(iqama):
    """A flat plate: hairline border, crop marks on the corners, a tick scale along the top,
    and the prayer gauge: a 270 degree arc with 41 ticks, the five major ones are the five
    prayers, the orange needle points at the current one. For the iqama the arc up to the
    needle is drawn in orange as well."""
    def fn(_area, cr, w, h):
        for i in range(8, 0, -1):  # a soft shadow below; stays under the blur rule's ignore_alpha
            cr.rectangle(M - i, M + 4 - i, W + 2 * i, H + 2 * i)
            cr.set_source_rgba(0, 0, 0, 0.014)
            cr.fill()
        cr.rectangle(M, M, W, H)
        cr.set_source_rgba(*PANEL, 0.98)
        cr.fill()
        cr.set_line_width(1)
        cr.rectangle(M + 0.5, M + 0.5, W - 1, H - 1)
        cr.set_source_rgb(*LINE)
        cr.stroke()
        # tick scale along the top edge: a major tick every 40px, a minor one every 8px
        for x in range(9, W - 1, 8):
            major = (x - 9) % 40 == 0
            cr.move_to(M + x + 0.5, M + 1)
            cr.line_to(M + x + 0.5, M + 1 + (7 if major else 4))
            cr.set_source_rgba(*(ALU if major else MUTED), 0.7 if major else 0.4)
            cr.stroke()
        # crop marks
        cr.set_source_rgb(*ALU)
        s = 10
        for cx, cy, dx, dy in ((M, M, 1, 1), (M + W, M, -1, 1), (M, M + H, 1, -1), (M + W, M + H, -1, -1)):
            cr.move_to(cx + dx * s, cy + dy * 0.5)
            cr.line_to(cx + dx * 0.5, cy + dy * 0.5)
            cr.line_to(cx + dx * 0.5, cy + dy * s)
            cr.stroke()

        cx, cy, r = M + 72, M + H / 2 + 6, 42
        a0, a1 = math.radians(135), math.radians(405)
        idx = NEEDLE["index"]
        na = a0 + (a1 - a0) * idx / 4
        cr.set_line_cap(cairo.LINE_CAP_BUTT)
        cr.arc(cx, cy, r, a0, a1)
        cr.set_source_rgb(*ALU)
        cr.set_line_width(1.4)
        cr.stroke()
        if iqama:
            cr.arc(cx, cy, r - 13, a0, na)
            cr.set_source_rgb(*ORANGE)
            cr.set_line_width(2.4)
            cr.stroke()
        for k in range(41):
            a = a0 + (a1 - a0) * k / 40
            big = k % 10 == 0
            cr.move_to(cx + r * math.cos(a), cy + r * math.sin(a))
            cr.line_to(cx + (r - (9 if big else 4)) * math.cos(a), cy + (r - (9 if big else 4)) * math.sin(a))
            cr.set_source_rgb(*(TEXT if big else MUTED))
            cr.set_line_width(1.6 if big else 1)
            cr.stroke()
        cr.move_to(cx - 9 * math.cos(na), cy - 9 * math.sin(na))
        cr.line_to(cx + (r - 11) * math.cos(na), cy + (r - 11) * math.sin(na))
        cr.set_source_rgb(*ORANGE)
        cr.set_line_width(2.6)
        cr.stroke()
        cr.arc(cx, cy, 4.2, 0, 2 * math.pi)
        cr.set_source_rgb(*PANEL)
        cr.fill_preserve()
        cr.set_source_rgb(*ALU)
        cr.set_line_width(1.4)
        cr.stroke()
    return fn


def until(ts):
    s = max(0, int(ts - time.time()))
    m, s = divmod(s, 60)
    return f"in {m}m {s:02d}s" if m else f"in {s}s"


def build(app, a, monitor):
    win = Gtk.ApplicationWindow(application=app)
    LS.init_for_window(win)
    LS.set_namespace(win, "hattin-mawaqit")
    LS.set_layer(win, LS.Layer.OVERLAY)
    LS.set_anchor(win, LS.Edge.TOP, True)
    LS.set_margin(win, LS.Edge.TOP, 14 - M // 2)
    LS.set_keyboard_mode(win, LS.KeyboardMode.NONE)
    LS.set_monitor(win, monitor)
    win.set_default_size(W + 2 * M, H + 2 * M)

    iqama = a["kind"] == "iqama"
    NEEDLE["index"] = PRAYER_INDEX.get("".join(c for c in a["en"].lower() if c.isascii() and c.isalpha()), 2)
    area = Gtk.DrawingArea()
    area.set_content_width(W + 2 * M)
    area.set_content_height(H + 2 * M)
    area.set_draw_func(draw(iqama))

    name = Gtk.Label(label=a["en"], xalign=0)
    name.add_css_class("name")
    ar = Gtk.Label(label=a["ar"], xalign=0, hexpand=True)
    ar.add_css_class("ar")
    tag = Gtk.Label(label="IQAMA" if iqama else "ADHAN", xalign=1, valign=Gtk.Align.START)
    tag.add_css_class("tag")
    if iqama:
        tag.add_css_class("iqama")
    title = Gtk.Box(spacing=12)
    title.append(name)
    title.append(ar)
    title.append(tag)

    sub = Gtk.Label(xalign=0)
    sub.add_css_class("sub")

    minutes = max(1, round(int(a.get("duration", 240)) / 60))
    hint = Gtk.Label(label=f"{minutes} MIN" if iqama else "DISMISS", xalign=1)
    hint.add_css_class("hint")

    def tick():
        head = f"{a['mosque']} · {a['time']}"
        if iqama:
            sub.set_label(f"{a['mosque']} · {a.get('iqama') or a['time']} · the prayer is starting")
        elif a.get("iqama_ts") and a["iqama_ts"] > time.time():
            sub.set_label(f"{head} · iqama {a['iqama']} · {until(a['iqama_ts'])}")
        elif a.get("iqama"):
            sub.set_label(f"{head} · iqama {a['iqama']} · now")
        else:
            sub.set_label(f"{head} · time for prayer")
        return True
    tick()
    GLib.timeout_add_seconds(1, tick)

    card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2, valign=Gtk.Align.START)
    card.add_css_class("card")
    card.set_margin_top(M)
    card.set_margin_start(M)
    card.set_margin_end(M)
    for w in (title, sub, hint):
        card.append(w)

    over = Gtk.Overlay()
    over.set_child(area)
    over.add_overlay(card)
    win.set_child(over)

    click = Gtk.GestureClick()
    click.connect("pressed", lambda *_: app.quit())
    win.add_controller(click)
    win.present()


def main():
    a = json.loads(sys.argv[1])
    app = Gtk.Application(application_id=None)

    def activate(app):
        prov = Gtk.CssProvider()
        prov.load_from_data(CSS)
        disp = Gdk.Display.get_default()
        Gtk.StyleContext.add_provider_for_display(disp, prov, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        mons = disp.get_monitors()
        for i in range(mons.get_n_items()):
            build(app, a, mons.get_item(i))
        app.hold()
        GLib.timeout_add_seconds(max(30, int(a.get("duration", 300))), app.quit)
        sound = chime(a["kind"])
        if sound and os.path.exists(sound):
            def ring():
                subprocess.Popen(["pw-play", "--media-role", "Notification", sound],
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                return False
            ring()
            # one reminder if the banner is still up; dismissing quits first
            GLib.timeout_add_seconds(REPEAT, ring)

    app.connect("activate", activate)
    app.run([])


if __name__ == "__main__":
    main()
